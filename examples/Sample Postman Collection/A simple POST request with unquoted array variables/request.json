{
  "url": "https://postman-echo.com/post",
  "method": "POST",
  "header": [
    {
      "key": "Content-Type",
      "value": "application/json"
    }
  ],
  "body": {
    "mode": "raw",
    "raw_json_formatted": {
      "items": [
        "__UQ__{{itemsJson}}"
      ],
      "tags": [
        "__UQ__{{tag1}}",
        "__UQ__{{tag2}}"
      ]
    }
  }
}
